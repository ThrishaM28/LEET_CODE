class Solution(object):
    def findMaxAverage(self, nums, k):
        window_sum=sum(nums[:k])
        m=window_sum
        for i in range(k,len(nums)):
            window_sum=(window_sum + nums[i])-(nums[i-k])
            if window_sum>m:
                m=max(m,window_sum)
        return float(m)/k
